# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration Example
# Copy this file to .env and fill in your actual values
# ─────────────────────────────────────────────────────────────────────────────

# Environment
NODE_ENV=development

# Port
PORT=3002

# Database
MONGODB_URI=mongodb://localhost:27017/picup

# JWT
JWT_SECRET=your_jwt_secret_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────────────────────
# REDIS_URL: Connection string to Redis server
#   - Default: redis://localhost:6379
#   - Production: Use your Redis server URL (e.g., redis://redis-server:6379)
#   - With Auth: redis://username:password@hostname:6379
REDIS_URL=redis://localhost:6379

# USE_REAL_REDIS: Force real Redis even in development
#   - Set to 'true' to use actual Redis in development
#   - Set to 'false' or omit to use in-memory cache (default for development)
#   - In production, always uses real Redis
USE_REAL_REDIS=false

# ─────────────────────────────────────────────────────────────────────────────
# Note on Redis in Development:
# ─────────────────────────────────────────────────────────────────────────────
# - By default (NODE_ENV=development), the app uses in-memory cache (no Redis needed)
# - If Redis is unavailable in production, the app gracefully falls back to direct DB writes
# - Set USE_REAL_REDIS=true if you want to test Redis locally
# ─────────────────────────────────────────────────────────────────────────────

# CloudFlare R2 (optional)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-bucket.your-account.r2.cloudflarestorage.com

# Stripe (optional)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Email Service (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
